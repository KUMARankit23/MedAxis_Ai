# ─────────────────────────────────────────────────────────────────────────────
# MedAxis Platform — Environment Variables
# Copy this file to .env and fill in your values before running docker compose.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: Must be at least 32 characters. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_STRING_HERE_MINIMUM_32_CHARS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcard in production.
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Sentry (optional — leave blank to disable) ────────────────────────────────
SENTRY_DSN=
REACT_APP_SENTRY_DSN=
ENVIRONMENT=production

# ── AI / LLM (optional) ───────────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=pattern

# ── Service URLs (Docker internal — do not change unless renaming containers) ──
AUTH_SERVICE_URL=http://auth-service:8001
INVENTORY_SERVICE_URL=http://inventory-service:8002
BILLING_SERVICE_URL=http://billing-service:8003
REPLENISHMENT_SERVICE_URL=http://replenishment-service:8004
REPORTING_SERVICE_URL=http://reporting-service:8005
AI_SERVICE_URL=http://ai-insights-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set to your public HTTPS domain in production
REACT_APP_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Gateway rate limiting ─────────────────────────────────────────────────────
RATE_LIMIT=100
RATE_WINDOW=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── pgAdmin (production only) ─────────────────────────────────────────────────
PGADMIN_EMAIL=admin@medaxis.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# ── Backup retention ─────────────────────────────────────────────────────────
BACKUP_RETAIN_DAYS=7
